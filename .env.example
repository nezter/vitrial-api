DATABASE_URL=postgresql+asyncpg://vitrial:vitrial@localhost:5432/vitrial
DATABASE_NULL_POOL=false
# Single-process API connection budget. Keep pool_size + max_overflow below
# the provider's max_connections with room for migrations/operator access.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Whole-request byte ceilings for bounded JSON ingress. These defaults mirror
# app/request_size.py and remain above the current iOS wire budgets.
VITRIAL_MAX_BODY_BYTES_API_V1_AUTH_PAIR=16384
VITRIAL_MAX_BODY_BYTES_API_V1_SYNC_PUSH=4194304
VITRIAL_MAX_BODY_BYTES_API_V2_SYNC_PUSH=4194304
VITRIAL_MAX_BODY_BYTES_INTERNAL_ADMIN_V1=65536
# In-process auth limiter. These values are per API instance; a multi-instance
# deployment requires a shared limiter before treating this as a global ceiling.
VITRIAL_AUTH_RATE_LIMIT=30
VITRIAL_AUTH_RATE_WINDOW_SECONDS=60
SERVICE_VERSION=0.3.0
API_VERSION=v1

# Internal admin/provisioning API is disabled while this is empty.
# Configure only the lowercase SHA-256 digest of a separately managed admin key.
ADMIN_API_KEY_HASH=

EVIDENCE_STORAGE_PROVIDER=local
EVIDENCE_ROOT=./.evidence
EVIDENCE_GC_GRACE_SECONDS=86400
EVIDENCE_MAX_BYTES=104857600

S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=vitrial-evidence
S3_REGION=us-east-1
S3_PART_SIZE_BYTES=5242880
