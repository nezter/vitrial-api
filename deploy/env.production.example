# Copy to a host-only path such as /etc/vitrial/vitrial.env and chmod 600.
# Never commit the populated file. Use immutable image references in real deployments.

API_HOST=api.example.com
API_IMAGE=ghcr.io/example/vitrial-api@sha256:REPLACE_WITH_IMAGE_DIGEST
CADDY_IMAGE=caddy:2-alpine
SERVICE_VERSION=0.2.0

# Production mode: managed/external PostgreSQL and S3-compatible storage.
DATABASE_URL=postgresql+asyncpg://vitrial:REPLACE_WITH_URL_ENCODED_PASSWORD@db.example.internal:5432/vitrial
DATABASE_NULL_POOL=false
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
S3_BUCKET=vitrial-evidence
S3_REGION=us-east-1
S3_PART_SIZE_BYTES=5242880
EVIDENCE_GC_GRACE_SECONDS=86400
# Application-layer streaming ceiling; enforced even when clients omit Content-Length.
EVIDENCE_MAX_BYTES=104857600

# SHA-256 hex digest of a separately stored admin bootstrap key; leave empty to disable admin provisioning.
ADMIN_API_KEY_HASH=REPLACE_WITH_64_HEX_SHA256

# Single-host acceptance mode only. Data ports remain private to the Compose network.
# MinIO prebuilt images are gone entirely, not merely legacy: quay.io and Docker Hub
# both answer 401 for minio/minio and minio/mc, and dl.min.io answers 410 Gone
# (verified 2026-09-28, with a library/alpine control pull that succeeded). RustFS is
# the S3 server now. It is a real implementation, which matters because the evidence
# storage layer exercises multipart upload, and it is Apache 2.0 rather than AGPL.
# No client image is needed: bucket creation runs inside the API image, which already
# carries boto3.
POSTGRES_IMAGE=postgres:17
POSTGRES_DB=vitrial
POSTGRES_USER=vitrial
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
S3_IMAGE=rustfs/rustfs:1.0.0
S3_ROOT_USER=REPLACE_WITH_LONG_RANDOM_ACCESS_KEY
S3_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET_KEY

# Optional host-port overrides; production defaults are 80/443.
HTTP_PORT=80
HTTPS_PORT=443
